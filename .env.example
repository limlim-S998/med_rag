# Credential-free local platform development. Medical handlers remain held back.
MEDW_ENV=local
MEDW_BACKEND=local
MEDW_LOG_LEVEL=INFO
MEDW_LOCAL_STATE_PATH=/tmp/medw-platform.sqlite3
MEDW_LOCAL_ARTIFACT_DIR=/tmp/medw-artifacts
MEDW_SYNTHETIC_ENABLED=true

MEDW_QDRANT_URL=http://localhost:6333
MEDW_RERANKER_URL=http://localhost:8002
MEDW_RETRIEVAL_URL=http://localhost:8001
MEDW_GENERATION_URL=http://localhost:8003
MEDW_INGESTION_URL=http://localhost:8004

# Writer routes still require verified JWTs and explicit study membership.
# These are needed for authenticated route development, not synthetic probes.
MEDW_AUTH_TENANT_ID=
MEDW_AUTH_AUDIENCE=
MEDW_AUTH_ISSUER=
MEDW_AUTH_JWKS_URL=

# Azure configuration is explicit; no shared resource is contacted by default.
# See README.md#azure-commissioning before configuring an Azure environment.
MEDW_AOAI_ENDPOINT=
MEDW_AOAI_RESOURCE_ID=
MEDW_SEARCH_ENDPOINT=
MEDW_COSMOS_ENDPOINT=
MEDW_COSMOS_DATABASE=medw
MEDW_COSMOS_STATE_CONTAINER=platform-state
MEDW_BLOB_ACCOUNT_URL=
MEDW_SQL_SERVER=
MEDW_SQL_DATABASE=medw
MEDW_DOCINTEL_ENDPOINT=
MEDW_LANGUAGE_ENDPOINT=
MEDW_APPINSIGHTS_CONNECTION_STRING=

# Deployed Qdrant keys come from Kubernetes Secret references.
MEDW_QDRANT_API_KEY=
