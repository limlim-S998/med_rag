MEDW_ENV=dev
MEDW_LOG_LEVEL=DEBUG

# --- Azure OpenAI: deployment names, version pinned in the name ----------
MEDW_AOAI_ENDPOINT=https://med-rag-test1.openai.azure.com/
MEDW_CHAT_DEPLOYMENT=gpt-4.1-mini-2025-04-14
MEDW_EMBED_DEPLOYMENT=text-embedding-3-large-1
MEDW_EMBED_VERSION=v3l-001

# --- retrieval stores ----------------------------------------------------
MEDW_QDRANT_URL=http://localhost:6333
MEDW_SEARCH_ENDPOINT=https://medwdevsearch.search.windows.net
MEDW_SEARCH_INDEX=csr-chunks

# --- document parsing and clinical NER -----------------------------------
MEDW_DOCINTEL_ENDPOINT=https://medwdevdi.cognitiveservices.azure.com/
MEDW_LANGUAGE_ENDPOINT=https://medwdevlang.cognitiveservices.azure.com/

# --- state ---------------------------------------------------------------
MEDW_BLOB_ACCOUNT_URL=https://medwdevsa.blob.core.windows.net
MEDW_COSMOS_ENDPOINT=https://medwdevcosmos.documents.azure.com:443/
MEDW_COSMOS_DATABASE=medw
MEDW_SQL_SERVER=medwdevsql.database.windows.net
MEDW_SQL_DATABASE=medw

# --- models with weights -------------------------------------------------
MEDW_AZUREML_WORKSPACE=medw-dev-ws
MEDW_TABLE_CLASSIFIER_VERSION=7

# --- telemetry -----------------------------------------------------------
MEDW_APPINSIGHTS_CONNECTION_STRING=

# No keys. Auth is `az login` locally, workload identity in the cluster.
# The single exception is the local Azure SQL Edge container, which cannot do
# AAD - and it is why this one variable is not MEDW_-prefixed: it is not a
# setting the application reads, it is a docker-compose detail.
LOCAL_SQL_PASSWORD=ChangeMe_local_only_1
